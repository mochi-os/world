#!/usr/bin/env bash
# Deploy the published mochi-world package to yuzu via its local
# file:/srv/apt repo (already rsync'd there by `make release`), verified.
# Each `apt install` runs the package prerm/postinst, which gracefully
# restarts mochi-world.
#
# Invoked by `make -C world deploy`, the single allow-listed entry point for
# the production deploy: the ssh calls run inside the allowed make process
# rather than as separately-gated production writes. Extra apt flags (e.g.
# --reinstall to redeploy an identical version on `/world-release same`) are
# passed as arguments.
set -euo pipefail

flags="$*"

deploy() {
	local host="$1" role="$2"
	echo "=== Deploying mochi-world to $host ($role) ==="
	# --force-confold: keep the operator's edited conffile. Without it, a
	# changed packaged world.conf makes dpkg prompt on the non-interactive
	# ssh, fail on EOF, and leave the package half-configured with the
	# service STOPPED (prerm runs before the prompt, postinst never runs) —
	# which took production down on the 1.2 deploy. Keeping the installed
	# file is dpkg's own default at that prompt; if a release ever needs a
	# new key, the is-active check below catches the refusal to start.
	ssh "root@$host" "DEBIAN_FRONTEND=noninteractive apt update && DEBIAN_FRONTEND=noninteractive apt install -y -o Dpkg::Options::=--force-confold $flags mochi-world"
	ssh "root@$host" "dpkg-query -W -f='$host mochi-world \${Version}\n' mochi-world; systemctl is-active mochi-world"
}

deploy yuzu.mochi-os.org primary
